# =================================================================
# DocAI Platform - Environment Configuration Reference
# =================================================================

# --- Production / Cloud Database (Render PostgreSQL) ---
# Automatically provided by Render's docai-db service in render.yaml.
# For local development with PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/doc_platform
# If DATABASE_URL is not set, SQLite is used locally: sqlite:///./doc_platform.db

# --- Security / JWT ---
# Used to sign JWT session tokens (HS256). In production, Render auto-generates this.
SECRET_KEY=generate_a_secure_random_64_char_hex_string_here

# --- AI LLM Integration (Groq) ---
# Required for RAG contextual chat, summarization, and quiz generation.
# Obtain a free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# --- Cloud File Storage (Cloudinary) ---
# Option A (Recommended): Full URL format from Cloudinary Dashboard
CLOUDINARY_URL=cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>

# Option B: Individual credentials (alternative to CLOUDINARY_URL)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Runtime & Model Caching (Handled automatically in Docker) ---
SENTENCE_TRANSFORMERS_HOME=/app/.cache/sentence_transformers
PYTHONUNBUFFERED=1

# --- Frontend Environment Variables (Only needed for separate local dev) ---
# In production, the Docker container serves the frontend SPA on the same origin (/api/v1).
# VITE_API_BASE_URL=http://localhost:8000/api/v1
